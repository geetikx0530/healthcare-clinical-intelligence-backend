# Application Settings
PROJECT_NAME="Clinical Decision Intelligence API"
API_V1_STR="/api"
PORT=8000
DEBUG=True

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Database Settings (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/clinical_ai"

# JWT Security Settings
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_PRODUCTION"
JWT_SECRET_KEY="replace-with-a-secure-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Upload Settings
UPLOAD_DIR="uploads"
